{
  "Comment": "FIDE scraping pipeline: ensure_run_name -> federations -> tournaments -> parallel(split_ids, player_list) -> Map(details+reports) -> merge -> validate",
  "StartAt": "EnsureRunName",
  "States": {
    "EnsureRunName": {
      "Type": "Task",
      "Resource": "${EnsureRunNameFunctionArn}",
      "Parameters": {
        "input.$": "$"
      },
      "ResultPath": "$",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "Federations"
    },
    "Federations": {
      "Type": "Task",
      "Resource": "${FederationsFunctionArn}",
      "Parameters": {
        "bucket.$": "$.bucket",
        "override.$": "$.override"
      },
      "ResultPath": "$.federations",
      "Retry": [
        {
          "ErrorEquals": ["FideBlocked"],
          "IntervalSeconds": 1800,
          "MaxAttempts": 5,
          "BackoffRate": 2,
          "MaxDelaySeconds": 14400
        },
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "Tournaments"
    },

    "Tournaments": {
      "Type": "Task",
      "Resource": "${TournamentsFunctionArn}",
      "Parameters": {
        "year.$": "$.year",
        "month.$": "$.month",
        "run_type.$": "$.run_type",
        "run_name.$": "$.run_name",
        "bucket.$": "$.bucket",
        "override.$": "$.override",
        "tournaments_rate_limit.$": "$.tournaments_rate_limit",
        "federations_s3_uri.$": "$.federations_s3_uri"
      },
      "ResultPath": "$.tournaments",
      "Retry": [
        {
          "ErrorEquals": ["FideBlocked"],
          "IntervalSeconds": 1800,
          "MaxAttempts": 5,
          "BackoffRate": 2,
          "MaxDelaySeconds": 14400
        },
        {
          "ErrorEquals": ["Sandbox.Timedout"],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "TournamentsProgress"
    },

    "TournamentsProgress": {
      "Type": "Choice",
      "Comment": "Resumable: call again while federations remain and the last call made progress",
      "Choices": [
        {
          "And": [
            {"Variable": "$.tournaments.remaining", "NumericGreaterThan": 0},
            {"Variable": "$.tournaments.progress", "NumericGreaterThan": 0}
          ],
          "Next": "Tournaments"
        },
        {
          "Variable": "$.tournaments.remaining",
          "NumericGreaterThan": 0,
          "Next": "TournamentsStuck"
        }
      ],
      "Default": "ParallelSplitIdsAndPlayerList"
    },

    "TournamentsStuck": {
      "Type": "Fail",
      "Error": "TournamentsStuck",
      "Cause": "A tournaments call made no progress while federations remain. See the tournaments Lambda logs (chunk_summary failed_sample)."
    },

    "ParallelSplitIdsAndPlayerList": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "SplitIds",
          "States": {
            "SplitIds": {
              "Type": "Task",
              "Resource": "${SplitIdsFunctionArn}",
              "Parameters": {
                "run_type.$": "$.run_type",
                "run_name.$": "$.run_name",
                "bucket.$": "$.bucket",
                "override.$": "$.override",
                "chunk_size.$": "$.chunk_size"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "PlayerList",
          "States": {
            "PlayerList": {
              "Type": "Task",
              "Resource": "${PlayerListFunctionArn}",
              "Parameters": {
                "bucket.$": "$.bucket",
                "override.$": "$.override"
              },
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.parallel_split_player",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "CheckSplitIdsSuccess"
    },

    "CheckSplitIdsSuccess": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.parallel_split_player[0].success",
          "BooleanEquals": false,
          "Next": "SplitIdsFailed"
        }
      ],
      "Default": "CheckMaxConcurrency"
    },

    "CheckMaxConcurrency": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.max_concurrency",
          "IsPresent": true,
          "Next": "MapDetailsAndReports"
        }
      ],
      "Default": "EnsureMaxConcurrency"
    },

    "EnsureMaxConcurrency": {
      "Type": "Pass",
      "Parameters": {
        "year.$": "$.year",
        "month.$": "$.month",
        "run_type.$": "$.run_type",
        "run_name.$": "$.run_name",
        "bucket.$": "$.bucket",
        "override.$": "$.override",
        "federations.$": "$.federations",
        "tournaments.$": "$.tournaments",
        "parallel_split_player.$": "$.parallel_split_player",
        "chunk_size.$": "$.chunk_size",
        "tournaments_rate_limit.$": "$.tournaments_rate_limit",
        "details_rate_limit.$": "$.details_rate_limit",
        "reports_rate_limit.$": "$.reports_rate_limit",
        "max_concurrency": 1
      },
      "Next": "MapDetailsAndReports"
    },

    "SplitIdsFailed": {
      "Type": "Fail",
      "Error": "SplitIdsFailed",
      "CausePath": "$.parallel_split_player[0].error"
    },

    "MapDetailsAndReports": {
      "Type": "Map",
      "ItemsPath": "$.parallel_split_player[0].chunks",
      "MaxConcurrencyPath": "$.max_concurrency",
      "ItemSelector": {
        "run_type.$": "$$.Map.Item.Value.run_type",
        "run_name.$": "$$.Map.Item.Value.run_name",
        "chunk_index.$": "$$.Map.Item.Value.chunk_index",
        "chunk_count.$": "$$.Map.Item.Value.chunk_count",
        "bucket.$": "$.bucket",
        "override.$": "$.override",
        "details_rate_limit.$": "$.details_rate_limit",
        "reports_rate_limit.$": "$.reports_rate_limit"
      },
      "Iterator": {
        "StartAt": "DetailsChunk",
        "States": {
          "DetailsChunk": {
            "Type": "Task",
            "Resource": "${DetailsChunkFunctionArn}",
            "Parameters": {
              "run_type.$": "$.run_type",
              "run_name.$": "$.run_name",
              "chunk_index.$": "$.chunk_index",
              "chunk_count.$": "$.chunk_count",
              "bucket.$": "$.bucket",
              "override.$": "$.override",
              "details_rate_limit.$": "$.details_rate_limit"
            },
            "ResultPath": "$.details_result",
            "Retry": [
              {
                "ErrorEquals": ["FideBlocked"],
                "IntervalSeconds": 1800,
                "MaxAttempts": 5,
                "BackoffRate": 2,
                "MaxDelaySeconds": 14400
              },
              {
                "ErrorEquals": ["Lambda.TooManyRequestsException"],
                "IntervalSeconds": 10,
                "MaxAttempts": 6,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": ["Lambda.ServiceException"],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Sandbox.Timedout",
                  "Lambda.SdkClientException",
                  "Lambda.Unknown"
                ],
                "IntervalSeconds": 30,
                "MaxAttempts": 5,
                "BackoffRate": 2
              }
            ],
            "Next": "DetailsProgress"
          },
          "DetailsProgress": {
            "Type": "Choice",
            "Comment": "Resumable worker: call again while work remains and the last call made progress",
            "Choices": [
              {
                "And": [
                  {"Variable": "$.details_result.remaining", "NumericGreaterThan": 0},
                  {"Variable": "$.details_result.progress", "NumericGreaterThan": 0}
                ],
                "Next": "DetailsChunk"
              },
              {
                "Variable": "$.details_result.remaining",
                "NumericGreaterThan": 0,
                "Next": "ChunkStuck"
              }
            ],
            "Default": "ReportsChunk"
          },
          "ReportsChunk": {
            "Type": "Task",
            "Resource": "${ReportsChunkFunctionArn}",
            "Parameters": {
              "run_type.$": "$.run_type",
              "run_name.$": "$.run_name",
              "chunk_index.$": "$.chunk_index",
              "chunk_count.$": "$.chunk_count",
              "bucket.$": "$.bucket",
              "override.$": "$.override",
              "reports_rate_limit.$": "$.reports_rate_limit"
            },
            "ResultPath": "$.reports_result",
            "Retry": [
              {
                "ErrorEquals": ["FideBlocked"],
                "IntervalSeconds": 1800,
                "MaxAttempts": 5,
                "BackoffRate": 2,
                "MaxDelaySeconds": 14400
              },
              {
                "ErrorEquals": ["Lambda.TooManyRequestsException"],
                "IntervalSeconds": 10,
                "MaxAttempts": 6,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": ["Lambda.ServiceException"],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Sandbox.Timedout",
                  "Lambda.SdkClientException",
                  "Lambda.Unknown"
                ],
                "IntervalSeconds": 30,
                "MaxAttempts": 5,
                "BackoffRate": 2
              }
            ],
            "Next": "ReportsProgress"
          },
          "ReportsProgress": {
            "Type": "Choice",
            "Choices": [
              {
                "And": [
                  {"Variable": "$.reports_result.remaining", "NumericGreaterThan": 0},
                  {"Variable": "$.reports_result.progress", "NumericGreaterThan": 0}
                ],
                "Next": "ReportsChunk"
              },
              {
                "Variable": "$.reports_result.remaining",
                "NumericGreaterThan": 0,
                "Next": "ChunkStuck"
              }
            ],
            "Default": "ChunkDone"
          },
          "ChunkDone": {
            "Type": "Succeed"
          },
          "ChunkStuck": {
            "Type": "Fail",
            "Error": "ChunkStuck",
            "Cause": "A chunk invocation made no progress while tournaments remain (repeated non-block errors). See the chunk Lambda logs for failed_sample."
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "MergeChunks"
    },

    "MergeChunks": {
      "Type": "Task",
      "Resource": "${MergeChunksFunctionArn}",
      "Parameters": {
        "run_type.$": "$.run_type",
        "run_name.$": "$.run_name",
        "bucket.$": "$.bucket",
        "override.$": "$.override"
      },
      "ResultPath": "$.merge",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "Validate"
    },

    "Validate": {
      "Type": "Task",
      "Resource": "${ValidateFunctionArn}",
      "Parameters": {
        "run_type.$": "$.run_type",
        "run_name.$": "$.run_name",
        "bucket.$": "$.bucket"
      },
      "ResultPath": "$.validate",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "Success"
    },

    "Success": {
      "Type": "Succeed"
    },

    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "FIDE pipeline execution failed. Check state output for details."
    }
  }
}
